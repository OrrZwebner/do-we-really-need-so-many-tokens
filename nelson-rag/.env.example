# Copy to .env and adjust. Every value here is optional — the defaults work.

# --- Required to answer questions (indexing works without it) ---------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Where things live ------------------------------------------------------
# NELSON_SOURCE_DIR=./data/source
# NELSON_INDEX_DIR=./data/index

# --- What the citations should say ------------------------------------------
NELSON_BOOK_TITLE=Nelson Textbook of Pediatrics
# Set this. It appears in every citation, and the model uses it to judge how
# stale guideline-sensitive content might be.
NELSON_BOOK_EDITION=22nd edition (2024)

# --- Embeddings -------------------------------------------------------------
# local  = offline, free, nothing leaves the machine (default)
# voyage = hosted, better retrieval, sends passages to Voyage AI
# hash   = no model download; smoke tests only, poor quality
# NELSON_EMBEDDING_BACKEND=local
# NELSON_LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# VOYAGE_API_KEY=

# --- Retrieval tuning -------------------------------------------------------
# NELSON_FUSED_TOP_K=8
# NELSON_RERANKER=coverage        # coverage | cross-encoder | none
# NELSON_CHUNK_CHARS=2400

# --- Model ------------------------------------------------------------------
# NELSON_ANSWER_MODEL=claude-opus-5
# NELSON_EFFORT=high              # low | medium | high | xhigh | max
